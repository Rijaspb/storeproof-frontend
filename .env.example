# Vite only exposes variables prefixed with VITE_ to client code (import.meta.env.VITE_*)
VITE_APP_NAME=frontend
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: enables Sentry error reporting when set
VITE_SENTRY_DSN=addedto.env
